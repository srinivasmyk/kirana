<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP to private/Tailscale addresses only. Public internet still
  requires HTTPS. Since the backend lives on your tailnet, TLS certs would be
  pure ceremony - but this keeps the exception narrow instead of global.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">100.64.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
